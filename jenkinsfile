pipeline {

    agent any

    tools {
        jdk 'JDK-17'
        maven 'Maven-3.9'
    }

    environment {
        APP_NAME = 'webapp'
        MAVEN_OPTS = '-Dmaven.repo.local=$WORKSPACE/.m2/repository'
    }

    stages {

        stage('Checkout') {
            steps {
                git branch: 'main', url: 'https://github.com/Chirag21-dev/Java-Cicd'
            }
        }

        stage('Verify Environment') {
            steps {
                sh '''
                    java -version
                    mvn -version
                '''
            }
        }

        stage('Compile') {
            steps {
                sh 'mvn compile'
            }
        }

         stage('Build WAR') {
            steps {
                sh '''
                    mvn clean package -DskipTests
                '''
            }
        }

        /*stage('Verify Artifact') {
            steps {
                sh '''
                    ls -lh target/*.war
                '''
            }
        }
        stage('Upload WAR to Nexus') {
            steps {

                withCredentials([
                    usernamePassword(
                        credentialsId: 'nexus-credentials',
                        usernameVariable: 'NEXUS_USERNAME',
                        passwordVariable: 'NEXUS_PASSWORD'
                    )
                ]) {

                    sh '''
                        mvn deploy -DskipTests \
                            -Dnexus.username="$NEXUS_USERNAME" \
                            -Dnexus.password="$NEXUS_PASSWORD"
                    '''
                }
            }
        }
   post {

        success {
            echo 'WAR successfully built and uploaded to Nexus.'
        }

        failure {
            echo 'Pipeline failed.'
        }

        always {
            archiveArtifacts artifacts: 'target/*.war',
                             fingerprint: true,
                             allowEmptyArchive: true

            cleanWs()
        }
    }*/

stage('Docker Build') {
    steps {
        sh '''
            docker build \
                -t chiragks1/webapp:${BUILD_NUMBER} \
                -t chiragks1/webapp:latest \
                .
        '''
    }
}

 stage('Docker Push') {
    steps {
        withCredentials([
            usernameColonPassword(
                credentialsId: 'Dockerhub_cred',
                variable: 'Dockerhub_cred'
            )
        ]) {
            sh '''
                echo "$Dockerhub_cred" | docker login \
                    --username "$(echo "$Dockerhub_cred" | cut -d: -f1)" \
                    --password-stdin

                docker push chiragks1/webapp:${BUILD_NUMBER}
                docker push chiragks1/webapp:latest

                docker logout
            '''
        }
    }
}
}
}
